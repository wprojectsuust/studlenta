# Скопируйте в backend/.env. Все переменные — с префиксом STUDLENTA_.
STUDLENTA_DATABASE_URL=postgresql://studlenta:studlenta@localhost:5432/studlenta
# Минимум 32 символа. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
STUDLENTA_JWT_SECRET=
STUDLENTA_TIMEZONE=Asia/Yekaterinburg
STUDLENTA_MEDIA_ROOT=media
STUDLENTA_CORS_ORIGINS=http://localhost:5173
# false только для локального http; в проде — true
STUDLENTA_SECURE_COOKIES=false
# Для CLI (миграции, создание модератора, напоминания)
DATABASE_URL=postgresql://studlenta:studlenta@localhost:5432/studlenta
